{
  "name": "seviche-premium-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "images": "node scripts/images.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name seviche"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "preact-render-to-string": "^6.8.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
